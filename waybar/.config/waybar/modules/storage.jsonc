{
  "disk": {
    "tooltip": false,
    "interval": 60,
    "path": "/",
    // "format": "󱙋",
    "format": "󱙋 <span size='11pt'>{used}/{total}</span>",
    "states": {
      "warning": 80,
      "critical": 90
    }
  },
  "memory": {
    "tooltip": false,
    "interval": 15,
    // "format": "󰍛",
    "format": "󰍛 <span size='11pt'>{used}GiB</span>",
    "states": {
      "warning": 75,
      "critical": 85
    }
  }
}
