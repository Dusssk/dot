#!/bin/bash

dependencies=("waybar" "hyprpaper" "matugen" "imagemagick" "coreutils")
cache_dir="$HOME/.cache/wallchanger"
wall_dir="/mnt/sda2/wall"
resolution="100x100"
rofi_theme="$HOME/scripts/dependencies/wall/rofi-menu.rasi"
file="$cache_dir/command"

mapfile -t abs_wallpapers < <(find $wall_dir -type f -name "*.png" -o -name "*.jpg" -o -name "*.jpeg" -o -name "*.webp" -o -name "*.gif")
wallpapers=($(basename -a "${abs_wallpapers[@]}"))
parent=$(dirname "${abs_wallpapers[0]}")

if [[ ${#wallpapers[@]} -eq 0 ]]; then
    notify-send "ERROR: No wallpapers found at $wall_dir"
    exit 1
fi

parent=$(dirname "${abs_wallpapers[0]}")
wallpapers=($(basename -a "${abs_wallpapers[@]}"))
wall_amount=${#wallpapers[@]}

one_wallpapers=($(printf "%s\n" "${wallpapers[@]}" | grep -e "^å"))
two_wallpapers=($(printf "%s\n" "${wallpapers[@]}" | grep -v "^å"))
one_wall_amount=${#one_wallpapers[@]}
two_wall_amount=${#two_wallpapers[@]}

random_wall=$((RANDOM % wall_amount))
abs_wall="${abs_wallpapers[$random_wall]}"

base_cmd="matugen --prefer darkness image"
random_one_cmd="$base_cmd $abs_one_wall"
random_two_cmd="$base_cmd $abs_two_wall"
random_wall_cmd="$base_cmd $abs_wall"
wall_list=("${two_wallpapers[@]}")

for dependency in ${dependencies[@]}; do
  if ! pacman -Q $dependency > /dev/null; then
    sudo pacman -S --noconfirm "$dependency"
  fi
done

if [[ ! -d $cache_dir ]] || [[ ! -f $file ]]; then
  mkdir -p $cache_dir
  echo "Exported random wallpaper from '$wall_dir' into '$cache_dir'"
  echo "$random_two_cmd" > "$file"
fi

rofi_thumbnails() {
  local rofi_input=""
  for image in "${wall_list[@]}"; do
      local thumbnail="$cache_dir/$image"
      local abs_image="$parent/$image"

      if [[ ! -f "$thumbnail" ]]; then
          magick "$abs_image" -auto-orient -thumbnail "${resolution}^" -gravity center -extent "$resolution" "$thumbnail"
      fi
      rofi_input+="${image}\0icon\x1fthumbnail://${thumbnail}\n"
  done
  echo -n "$rofi_input"
}

rofi_selection() {
  local rofi_input
  rofi_input=$(rofi_thumbnails)

  selected_wall=$(echo -en "$rofi_input" | rofi -dmenu \
      -i \
      -show-icons \
      -theme "$rofi_theme" \
      -p "Choose wallpaper" \
      -format 's' \
      -selected-row 0)

  if [[ -z "$selected_wall" ]]; then
      exit 0
  fi

  selected_img="$parent/$selected_wall"
  if [[ ! -f "$selected_img" ]]; then
    notify-send "ERROR: Selected wallpaper not found"
    exit 1
  fi

  if matugen --prefer darkness image "$selected_img"; then
    echo "$base_cmd $selected_img" > "$file"1yyyyyy
    notify-send "Wallchanger" "Applied wallpaper: $selected_wall"
  else
    notify-send "ERROR: Failed to apply wallpaper"
    exit 1
  fi
}

wall_arg() {
  local wallpaper="$wall_dir/$OPTARG"
  local command="$base_cmd $wallpaper"
  echo "$command" > "$file"
  notify-send "Wallchanger" "Loaded wallpaper from input: $wallpaper"
  $command
}

if [[ $# -eq 0 ]]; then
  command=$(<"$file")
  echo "Loaded wallpaper from $file"
  $command
else
  list="0"
  menu="0"

  while getopts ":ralidw:" flag; do
    case "${flag}" in
      r) $random_two_cmd ;;
      a) wall_list=("${wallpapers[@]}") ;;
      l) list="1" ;;
      i) menu="1" ;;
      w) wall_arg ;;
      \?) echo "Usage: $0 [-r] [-a] [-l] [-i] [-w wallpaper]" >&2; exit 1 ;;
    esac
  done

  if [[ $list -eq 1 ]]; then
    printf "%s\n" "${wall_list[@]}"
    exit 0
  fi

  if [[ $menu -eq 1 ]]; then
    rofi_selection
  fi
fi

if pgrep waybar > /dev/null; then
  pkill waybar
  waybar &
fi
