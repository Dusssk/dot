#!/bin/bash

dependencies=("waybar" "hyprpaper" "matugen" "imagemagick" "coreutils")
cache_dir="$HOME/.cache/wallchanger"
wall_dir="/mnt/sda2/wall"
resolution="100x100"
rofi_theme="$HOME/scripts/dependencies/wall/rofi-menu.rasi"
file="$cache_dir/command"

mapfile -t abs_wallpapers < <(find $wall_dir -type f -o -name "*.png" -o -name "*.jpg" -o -name "*.jpeg" -o -name "*.webp" -o -name "*.gif")
wallpapers=($(basename -a ${abs_wallpapers[@]}))
parent=$(dirname $abs_wallpapers)

wall_amount=$(ls -1 $wall_dir | wc -l)
one_wallpapers=($(ls -1 $wall_dir | grep -e "^å"))
two_wallpapers=($(ls -1 $wall_dir | grep -v "^å"))
one_wall_amount=$(printf "%s\n" ${one_wallpapers[@]} | wc -l)
two_wall_amount=$(printf "%s\n" ${two_wallpapers[@]} | wc -l)
one_random_wall=$(($RANDOM % (${one_wall_amount[@]}) + 0))
two_random_wall=$(($RANDOM % (${two_wall_amount[@]}) + 0))
random_wall=$(($RANDOM % (${wall_amount[@]}) + 0))

abs_one_wall="$parent/${one_wallpapers[$one_random_wall]}"
abs_two_wall="$parent/${two_wallpapers[$two_random_wall]}"
abs_wall="${parent[$random_wall]}/${wallpapers[$random_wall]}"
base_cmd="matugen --prefer darkness image"
random_one_cmd="$base_cmd $abs_one_wall"
random_two_cmd="$base_cmd $abs_two_wall"
random_wall_cmd="$base_cmd $abs_wall"
wall_list=("${two_wallpapers[@]}")

for dependency in ${dependencies[@]}; do
  if ! pacman -Q $dependency > /dev/null; then
    sudo pacman -S --noconfirm "$dependency"
  fi
done

if [[ ! -d $cache_dir ]] || [[ ! -f $file ]]; then
  mkdir -p $cache_dir
  echo "Exported random wallpaper from '$wall_dir' into '$cache_dir'"
  echo "$random_two_cmd" > "$file"
fi

if [[ "${#wall_list}" -eq 0 ]]; then
  notify-send "ERROR: No wallpapers found at $wall_dir"
  exit 1
fi

rofi_menu () {
  rofi_input=""
  for image in "${wall_list[@]}"; do
    thumbnail="$cache_dir/$image"

    if [[ ! -f "$thumbnail" ]]; then
      magick "$image" -auto-orient -thumbnail "${resolution}^" -gravity center -extent "$resolution" "$thumbnail"
    fi
    rofi_input+="${image}\0icon\x1fthumbnail://${thumbnail}\n"
  done

  selected_wall=$(echo -en "$rofi_input" | rofi -dmenu \
    -i \
    -show-icons \
    -theme "$rofi_theme" \
    -p "Choose wallpaper" \
    -format 's' \
    -selected-row 0
  )
  selected_img="$parent/$selected_wall"
  selected_cmd="$base_cmd $selected_img"
  if [[ ! -f $selected_img ]]; then
    exit 0
  fi
  eval $selected_cmd
  echo "$selected_cmd" > $file
}

wall_arg () {
  echo ""
  wallpaper="$wall_dir/$OPTARG"
  command="matugen --prefer darkness image $wallpaper"
  echo "$command" > "$file"
  echo "Loaded wallpaper from input: $wallpaper"
  eval $command
}

if [[ $# -eq 0 ]]; then
  command=$(<$file)
  echo "Loaded wallpaper from $file"
  eval $command
else
  list="0"
  menu="0"

  while getopts ":ralidw:" flag; do
    case "${flag}" in
      r) eval $random_two_cmd ;;
      a) wall_list=("${wallpapers[@]}") ;;
      l) list="1" ;;
      i) menu="1" ;;
      w) wall_arg ;;
    esac
  done

  if [[ $list -eq 1 ]]; then
    printf "%s\n" ${wall_list[@]}
    exit 0
  fi

  if [[ $menu -eq 1 ]]; then
    rofi_menu
  fi
fi

if pgrep waybar > /dev/null; then
  pkill waybar
  waybar > /dev/null &
fi
