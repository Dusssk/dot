#!/bin/bash

dependencies=("waybar" "hyprpaper" "matugen" "imagemagick" "coreutils")
cache_dir="$HOME/.cache/wallchanger"
wall_dir="/mnt/sda2/wall"
resolution="100x100"
rofi_theme="$HOME/scripts/dependencies/wall/rofi-menu.rasi"
file="$cache_dir/command"

mapfile -t abs_wallpapers < <(find $wall_dir -type f -o -name "*.png" -o -name "*.jpg" -o -name "*.jpeg" -o -name "*.webp" -o -name "*.gif")
wallpapers=$(basename -a ${abs_wallpapers[@]})
one_wallpapers=($(printf "%s\n" $wallpapers | grep -e "^1"))
two_wallpapers=($(printf "%s\n" $wallpapers | grep -v "^1"))
one_wall_amount=$(printf "%s\n" ${one_wallpapers[@]} | wc -l)
two_wall_amount=$(printf "%s\n" ${two_wallpapers[@]} | wc -l)
one_random_wall=$(($RANDOM % (${one_wall_amount[@]}) + 0))
two_random_wall=$(($RANDOM % (${two_wall_amount[@]}) + 0))

parent=($(dirname ${abs_wallpapers[@]}))
abs_one_wall="${parent[$one_random_wall]}/${one_wallpapers[$one_random_wall]}"
abs_two_wall="${parent[$two_random_wall]}/${two_wallpapers[$two_random_wall]}"
base_cmd="matugen --prefer darkness image "
random_one_cmd="$base_cmd $abs_one_wall"
random_two_cmd="$base_cmd $abs_two_wall"

for dependency in ${dependencies[@]}; do
  if ! pacman -Q $dependency > /dev/null; then
    sudo pacman -S --noconfirm "$dependency"
  fi
done

if [[ ! -d $cache_dir ]] || [[ ! -f $file ]]; then
  mkdir -p $cache_dir
  echo "Exported random wallpaper from '$wall_dir' into '$cache_dir'"
  echo "$base_cmd" > "$file"
fi

if [[ "$two_wall_amount" -eq 0 ]]; then
  notify-send "ERROR: No wallpapers found at $wall_dir"
  exit 1
fi

if [[ $# -eq 0 ]]; then
  command=$(<$file)
  echo "Loaded wallpaper from $file"
  eval $command
fi

for arg in "$@"; do
  if [[ $arg = "-l" ]]; then
    printf "%s\n" ${two_wallpapers[@]}
    exit 0
  elif [[ $arg = "-al" ]]; then
    printf "%s\n" ${wallpapers[@]}
    exit 0
  elif [[ $arg = "-la" ]]; then
    printf "%s\n" ${wallpapers[@]}
    exit 0
  elif [[ $arg = "-r" ]]; then
    eval $random_two_cmd
  elif [[ $arg = "-ra" ]]; then
    eval $random_one_cmd
  elif [[ $arg = "-ar" ]]; then
    eval $random_one_cmd
  else
    echo ""
    wallpaper="$wall_dir/$1"
    command="matugen --prefer darkness image $wallpaper"
    echo "$command" > "$file"
    echo "Loaded wallpaper from input: $wallpaper"
    eval $command
  fi
done

if pgrep waybar > /dev/null; then
  pkill waybar
  waybar &
fi

