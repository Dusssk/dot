#!/bin/bash

if ! sudo rm -rf ~/.cache/debuginfod_client/; then
  echo "Error Cleaning the debuginfod cache"
  exit 1
fi

if ! mv "$HOME/.cache/wallchanger/command" "$HOME/command"; then
  echo "Error while temporarily moving the wallchanger cache"
  exit 1
else
  if ! rm -rf $HOME/.cache/* && sudo rm -rf /var/cache/*; then
    echo "Error Cleaning up cache directory"
  fi

  wall_dir="$HOME/.cache/wallchanger"
  if [[ ! -d "$wall_dir" ]]; then
    mkdir -p "$wall_dir"
  fi

  mv "$HOME/command" "$HOME/.cache/wallchanger/command"
fi

if ! sudo pacman -Rns $(pacman -Qdtq) > /dev/null; then
  echo ""
fi

echo "Cleaned up the debuginfod & cache directories"
